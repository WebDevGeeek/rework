<!DOCTYPE html>
<html>
<head>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .timeline {
            position: relative;
            padding: 20px 0;
        }
        
        .timeline-item {
            position: relative;
            padding: 20px 30px;
            border-left: 2px solid #0d6efd;
            margin-bottom: 30px;
        }
        
        .timeline-item::before {
            content: '';
            position: absolute;
            left: -10px;
            top: 25px;
            width: 20px;
            height: 20px;
            background: #0d6efd;
            border-radius: 50%;
        }
        
        .year-badge {
            display: inline-block;
            padding: 5px 15px;
            background-color: #0d6efd;
            color: white;
            border-radius: 20px;
            margin-bottom: 10px;
        }
        
        .hero-section {
            background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('/api/placeholder/1920/600');
            background-size: cover;
            background-position: center;
            color: white;
            padding: 100px 0;
        }
        
        .company-description {
            background-color: #f8f9fa;
            padding: 40px 0;
        }
    </style>
</head>
<body>

<!-- Hero Section -->
<section class="hero-section text-center">
    <div class="container">
        <h1 class="display-4 fw-bold">Our History</h1>
        <p class="lead">A Legacy of Excellence in Engineering and Innovation</p>
    </div>
</section>

<!-- Company Description -->
<section class="company-description">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <h2 class="text-center mb-4">TOYO MODEC OFS India Private Limited</h2>
                <p class="lead text-center">A joint venture company of Toyo Engineering India Private Limited and Offshore Frontier Solutions Pte. Ltd., established as a global capability centre in August 2024 at Bengaluru, India.</p>
            </div>
        </div>
    </div>
</section>

<!-- Timeline Section -->
<div class="container my-5">
    <div class="row">
        <div class="col-lg-6">
            <h3 class="mb-4">TOYO India Journey</h3>
            <div class="timeline">
                <div class="timeline-item">
                    <span class="year-badge">1976</span>
                    <p>Toyo-India was established by TOYO Engineering Corporation, Japan (Toyo-Japan) and started the Engineering centre in 1979.</p>
                </div>
                
                <div class="timeline-item">
                    <span class="year-badge">1990</span>
                    <p>With opening of Indian economy, Toyo-India emerged as 'Preferred Engineering Partner' amongst public sector companies and renowned corporate houses.</p>
                </div>
                
                <div class="timeline-item">
                    <span class="year-badge">Present</span>
                    <p>Nearly 5 decades of experience in execution of EPC, PMC or EPCM project assignments in diverse sectors including Oil & Gas Refineries, Petrochemicals, and more.</p>
                </div>
            </div>
        </div>
        
        <div class="col-lg-6">
            <h3 class="mb-4">MODEC Evolution</h3>
            <div class="timeline">
                <div class="timeline-item">
                    <span class="year-badge">1968</span>
                    <p>Mitsui Ocean Development & Engineering Company was founded as a joint venture by Mitsui & Co. and Mitsui Shipbuilding & Engineering.</p>
                </div>
                
                <div class="timeline-item">
                    <span class="year-badge">1987-1988</span>
                    <p>MODEC Technical Service took over the business and changed its name to MODEC, Inc., becoming a leading specialist in offshore oil and gas industry.</p>
                </div>
                
                <div class="timeline-item">
                    <span class="year-badge">2022</span>
                    <p>Offshore Frontier Solutions Pte. Ltd., Singapore (OFS-S) formed as a joint venture by MODEC Inc. and Toyo Engineering Corporation.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>

</body>
</html>